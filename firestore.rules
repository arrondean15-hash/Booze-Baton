rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: authenticated read, no client writes
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Voting: authenticated users can read and write
    match /dailyVotes/{date} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Config: authenticated read, writes only via Cloud Functions (Admin SDK)
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Users: authenticated read all, write own doc only
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Player name claims: authenticated read, writes only via Cloud Functions
    match /playerNames/{name} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
