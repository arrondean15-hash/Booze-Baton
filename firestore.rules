rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default rule: Public read access, no client writes
    // All writes must go through authenticated Cloud Functions
    match /{document=**} {
      allow read: if true;  // Anyone can view
      allow write: if false; // No client writes - must use Cloud Functions with password
    }

    // Voting collection: Allow public writes for daily voting
    // Anyone can submit/update their vote during voting hours
    match /dailyVotes/{date} {
      allow read: if true;
      allow write: if true;
    }

    // Config collection: Allow writes for player mappings
    match /config/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
